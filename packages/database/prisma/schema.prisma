generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Adicione aqui apenas modelos que pertençam ao domínio do novo projeto.
// Os seguintes são exemplos

enum StatusProduto {
  RASCUNHO
  ATIVO
  DESCONTINUADO
}

model Produto {
  id        String  @id @default(uuid()) @db.Uuid
  sku       String  @unique @db.VarChar(64)
  nome      String  @db.VarChar(64)
  descricao String? @db.Text
  urlManual String? @map("url_manual") @db.VarChar(2048)

  status     StatusProduto @default(RASCUNHO)
  emDestaque Boolean       @default(true) @map("em_destaque")

  estoque          Int     @default(0)
  preco            Decimal @db.Decimal(12, 2)
  pesoKg           Float?  @map("peso_kg")
  quantidadeVendas BigInt  @default(0) @map("quantidade_vendas")

  dataValidade DateTime? @map("data_validade") @db.Date
  disponivelEm DateTime? @map("disponivel_em") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  avaliacoes AvaliacaoProduto[]

  @@map("produtos")
}

model AvaliacaoProduto {
  id         String  @id @default(uuid()) @db.Uuid
  autorNome  String  @map("autor_nome") @db.VarChar(80)
  nota       Int
  comentario String? @db.VarChar(1000)
  recomenda  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  produtoId String @map("produto_id") @db.Uuid

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, createdAt])
  @@map("avaliacoes_produtos")
}
